<Layouts.app flash={@flash} current_scope={@current_scope} current_path={@current_path}>
  <div class="m-6 space-y-4 p-4">
    <%!-- Header --%>
    <.header>
      <p class="text-3xl">Description #{@alert_description.id}</p>
      <:subtitle>
        <div class="breadcrumbs text-sm">
          <ul>
            <li>
              <.link href={~p"/"}>
                <.icon name="hero-home" /> Home
              </.link>
            </li>
            <li>
              <.link href={~p"/"}>
                <.icon name="hero-document-text" /> Alert Descriptions
              </.link>
            </li>
            <li>
              <.link href={~p"/"}>
                {@alert_description.id}
              </.link>
            </li>
          </ul>
        </div>
      </:subtitle>
      <:actions>
        <button class="btn btn-primary" onclick="history.back()">
          <.icon name="hero-arrow-left" class="w-4 h-4" /> Back
        </button>
      </:actions>
    </.header>

    <%!-- Main Content --%>
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-4">
      <%!-- Left Column - Main Details --%>
      <div class="lg:col-span-2 space-y-4">
        <%!-- Overview Card --%>
        <div class="card bg-base-100 shadow-sm border border-base-200">
          <div class="card-body">
            <h2 class="card-title text-xl mb-4">
              <.icon name="hero-document-text" class="w-6 h-6" /> Overview
            </h2>

            <%!-- Metadata --%>
            <div class="flex flex-col gap-4">
              <%!-- Pattern --%>
              <div class="flex flex-col">
                <label class="label pb-1">
                  <span class="label-text font-semibold">Pattern</span>
                </label>
                <div class="bg-base-200 overflow-y-auto">
                  <pre class="px-4 py-3"><code class="text-sm text-base-content">{if @alert_description.pattern do
                      @alert_description.pattern
                    else
                      "No pattern defined"
                    end}</code></pre>
                </div>
              </div>
              <%!-- Rest --%>
              <div class="">
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
                  <div class="space-y-4">
                    <div>
                      <label class="label pb-1">
                        <span class="label-text font-semibold">Notification Group</span>
                      </label>
                      <div class="flex items-center space-x-2">
                        <.icon name="hero-user-group" class="w-4 h-4 text-gray-500" />
                        <span class="text-sm">
                          {if @alert_description.notification_group_id do
                            "Group #{@alert_description.notification_group.name}"
                          else
                            "No group assigned"
                          end}
                        </span>
                      </div>
                    </div>

                    <div>
                      <label class="label pb-1">
                        <span class="label-text font-semibold">Edited By</span>
                      </label>
                      <div class="flex items-center space-x-2">
                        <.icon name="hero-user" class="w-4 h-4 text-gray-500" />
                        <span class="text-sm">
                          {if @alert_description.edited_by do
                            "#{@alert_description.user.email}"
                          else
                            "-"
                          end}
                        </span>
                      </div>
                    </div>
                  </div>

                  <div class="space-y-4">
                    <div>
                      <label class="label pb-1">
                        <span class="label-text font-semibold">Created</span>
                      </label>
                      <div class="flex items-center space-x-2">
                        <.icon name="hero-calendar" class="w-4 h-4 text-gray-500" />
                        <span class="text-sm">
                          {Calendar.strftime(
                            @alert_description.inserted_at,
                            "%B %d, %Y at %H:%M UTC"
                          )}
                        </span>
                      </div>
                    </div>

                    <div>
                      <label class="label pb-1">
                        <span class="label-text font-semibold">Last Updated</span>
                      </label>
                      <div class="flex items-center space-x-2">
                        <.icon name="hero-clock" class="w-4 h-4 text-gray-500" />
                        <span class="text-sm">
                          {Calendar.strftime(
                            @alert_description.updated_at,
                            "%B %d, %Y at %H:%M UTC"
                          )}
                        </span>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>

        <%!-- Related Alerts Section --%>
        <div class="card bg-base-100 shadow-sm border border-base-200">
          <div class="card-body">
            <div class="flex items-center justify-between mb-6">
              <h2 class="card-title text-xl">
                <.icon name="hero-exclamation-triangle" class="w-6 h-6" /> Recent Alerts
              </h2>
              <.link navigate={~p"/alerts"} class="hover:cursor-pointer">
                <.icon name="hero-arrow-top-right-on-square" class="w-5 h-5" />
              </.link>
            </div>

            <div :if={Enum.empty?(@alerts)} class="text-center py-12">
              <.icon name="hero-inbox" class="w-16 h-16 text-gray-300 mx-auto mb-4" />
              <p class="text-gray-500 text-lg">No recent alerts</p>
              <p class="text-gray-400 text-sm">
                There are no alerts for this description in the last 48 hours.
              </p>
            </div>

            <div :if={not Enum.empty?(@alerts)} class="space-y-4">
              <div class="overflow-x-auto max-h-96 overflow-y-auto border border-base-200 rounded-lg">
                <table class="table table-zebra w-full">
                  <thead class="sticky top-0 bg-base-200 z-10">
                    <tr>
                      <th class="font-semibold">Alert Title</th>
                      <th class="font-semibold">Severity</th>
                      <th class="font-semibold">When</th>
                      <th class="font-semibold text-center">Actions</th>
                    </tr>
                  </thead>
                  <tbody>
                    <tr :for={alert <- @alerts} class="hover">
                      <td class="max-w-xs">
                        <div class="truncate font-medium">{alert.alert_title}</div>
                      </td>
                      <td>
                        <div class={[
                          "badge",
                          case alert.alert_severity do
                            "high" -> "badge-error"
                            "medium" -> "badge-warning"
                            "low" -> "badge-info"
                            _ -> "badge-outline"
                          end
                        ]}>
                          {String.capitalize(alert.alert_severity)}
                        </div>
                      </td>
                      <td class="text-sm">
                        <div class="space-y-1">
                          <span class="text-sm">
                            {Calendar.strftime(
                              alert.start,
                              "%B %d, %Y at %H:%M UTC"
                            )}
                          </span>
                        </div>
                      </td>
                      <td class="text-center">
                        <.link navigate={~p"/alerts/#{alert.id}"} class="btn btn-ghost btn-sm">
                          <.icon name="hero-eye" class="w-4 h-4" />
                        </.link>
                      </td>
                    </tr>
                  </tbody>
                </table>
              </div>
            </div>
          </div>
        </div>
      </div>

      <%!-- Right Column - Sidebar --%>
      <div class="space-y-4">
        <%!-- Quick Stats --%>
        <div class="card bg-base-100 shadow-sm border border-base-200">
          <div class="card-body">
            <h3 class="card-title text-lg mb-4">
              <.icon name="hero-chart-bar" class="w-5 h-5" /> Quick Stats
            </h3>

            <div class="flex flex-col gap-2">
              <section>
                <p class="stat-title text-xs">Total Alerts</p>
                <p class="stat-value text-2xl text-primary">{@total_alerts}</p>
              </section>

              <section>
                <p class="stat-title text-xs">Total Assignments</p>
                <p class="stat-value text-2xl text-secondary">{@total_assignments}</p>
              </section>

              <section>
                <p class="stat-title text-xs">Status</p>
                <div class="flex flex-row gap-2 mt-1">
                  <.state_badge state={@alert_description.state} />
                  <.state_badge
                    state={@alert_description.state}
                    color_func={
                      fn _state ->
                        if @alert_description.verified, do: "badge-success", else: "badge-warning"
                      end
                    }
                    text_func={
                      fn _state ->
                        if @alert_description.verified, do: "Verified", else: "Unverified"
                      end
                    }
                  />
                </div>
              </section>
            </div>
          </div>
        </div>

        <%!-- Alert Assignments --%>
        <div class="card bg-base-100 shadow-sm">
          <div class="card-body">
            <div class="flex flex-row items-center justify-between">
              <h3 class="card-title text-lg">
                <.icon name="hero-clock" class="w-5 h-5" /> Recent Assignments
              </h3>
              <div class="flex flex-row gap-2 items-center">
                <div class="tooltip tooltip-left text-sm hover:cursor-pointer">
                  <div class="tooltip-content text-start">
                    Results from the last 48 hours, limited to 10. <br />
                    Blue indicator displays an "open" status. <br />
                    Green indicator displays an "closed" status. <br />
                    Orange indicator displays an "expired" status.
                  </div>
                  <.icon name="hero-question-mark-circle" class="w-5 h-5" />
                </div>
                <.link navigate={~p"/alerts"} class="hover:cursor-pointer">
                  <.icon name="hero-arrow-top-right-on-square" class="w-5 h-5" />
                </.link>
              </div>
            </div>

            <div :if={Enum.empty?(@alert_assignments)} class="text-center py-8">
              <.icon name="hero-user-plus" class="w-12 h-12 text-gray-300 mx-auto mb-3" />
              <p class="text-gray-500">No recent assignments</p>
              <p class="text-gray-400 text-sm">
                No users assigned to this alert in the last 48 hours.
              </p>
            </div>

            <div :if={not Enum.empty?(@alert_assignments)} class="flex flex-col gap-2">
              <div class="max-h-64 overflow-y-auto space-y-2 rounded-lg">
                <div
                  :for={assignment <- @alert_assignments}
                  class="bg-base-200 rounded-lg p-3 hover:bg-base-300 hover:cursor-pointer transition-colors"
                >
                  <.link navigate={~p"/assignments/acknowledge/#{assignment.id}"}>
                    <div class="flex items-center justify-between gap-2">
                      <div class="flex-1 min-w-0">
                        <div class="font-medium text-sm overflow-hidden truncate flex flex-row items-center gap-2">
                          <div class={"w-2 h-2 #{assignment_indicator_class(assignment.status)} rounded-full"}>
                          </div>
                          {assignment.user.username}
                        </div>
                      </div>
                      <div class="text-xs text-gray-500 flex-shrink-0">
                        {Timex.format!(assignment.inserted_at, "{relative}", :relative)}
                      </div>
                    </div>
                  </.link>
                </div>
              </div>
            </div>
          </div>
        </div>

        <%!-- Actions --%>
        <div class="card bg-base-100 shadow-sm border border-base-200">
          <div class="card-body">
            <h3 class="card-title text-lg mb-4">
              <.icon name="hero-cog-6-tooth" class="w-5 h-5" /> Actions
            </h3>

            <div class="space-y-3">
              <.link
                navigate={~p"/descriptions/#{@alert_description.id}/edit"}
                class="btn btn-primary btn-block"
              >
                <.icon name="hero-pencil" class="w-4 h-4" /> Edit Description
              </.link>

              <button
                class="btn btn-error btn-soft btn-block"
                phx-click="delete_description"
                phx-value-id={@alert_description.id}
                data-confirm="Are you sure you want to delete this alert description? This action cannot be undone."
              >
                <.icon name="hero-trash" class="w-4 h-4" /> Delete
              </button>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</Layouts.app>
