<Layouts.app flash={@flash} current_scope={@current_scope}>
  <div class="max-w-5xl mx-auto space-y-4">
    <%!-- Title --%>
    <.header>
      <p class="text-2xl">Acknowledge Assignment</p>

      <:actions>
        <button class="btn btn-circle btn-soft btn-sm">?</button>
      </:actions>
    </.header>

    <div class="flex flex-col md:flex-row gap-4 w-full">
      <%!-- Assignment Status --%>
      <div class="card shadow-sm bg-base-100 flex-1">
        <div class="card-body p-4 text-center flex flex-col justify-between items-center gap-2">
          <div class="flex flex-col">
            <h4 class={[
              "font-semibold text-sm",
              case @assignment.status do
                :open -> "text-info"
                :closed -> "text-success"
                :waiting -> "text-warning"
                _ -> "text-base-content"
              end
            ]}>
              Assignment Status
            </h4>
            <p class="text-xs opacity-70">
              {if @assignment.status == :open do
                Calendar.strftime(@assignment.inserted_at, "%Y-%m-%d %H:%M")
              else
                Calendar.strftime(@assignment.metadata.closed_at, "%Y-%m-%d %H:%M")
              end}
            </p>
          </div>
          <div class={[
            "badge badge-lg",
            case @assignment.status do
              :open -> "badge-info"
              :closed -> "badge-success"
              :waiting -> "badge-warning"
              _ -> "badge-neutral"
            end
          ]}>
            {String.capitalize(to_string(@assignment.status))}
          </div>
        </div>
      </div>

      <%!-- Point Recovery --%>
      <%= if @assignment.status == :open do %>
        <div class="card shadow-sm bg-base-100 flex-1">
          <div class="card-body p-4 text-center flex flex-col justify-between items-center gap-2">
            <div class="flex flex-col">
              <h4 class={[
                "font-semibold text-sm",
                if(@meta.can_recover, do: "text-success", else: "text-error")
              ]}>
                Point Recovery
              </h4>
              <p class="text-xs opacity-70">
                <%= if @meta.can_recover do %>
                  {@meta.recoverable_standing} point(s) can be restored
                <% else %>
                  Not eligible
                <% end %>
              </p>
            </div>
            <div class="flex justify-center">
              <%= if @meta.can_recover do %>
                <div class="w-7 h-7 bg-success text-white rounded-full flex items-center justify-center">
                  <span class="text-xs text-success-content">+</span>
                  <span class="text-success-content text-lg text-bold">
                    {@meta.recoverable_standing}
                  </span>
                </div>
              <% else %>
                <div class="w-7 h-7 bg-error text-white rounded-full flex items-center justify-center">
                  <span class="text-xs text-error-content">-</span>
                  <span class="text-error-content text-lg text-bold">
                    {@meta.recoverable_standing}
                  </span>
                </div>
              <% end %>
            </div>
          </div>
        </div>
      <% else %>
        <div class="card shadow-sm bg-base-100 flex-1">
          <div class="card-body p-4 text-center flex flex-col justify-between items-center gap-2">
            <div class="flex flex-col">
              <h4 class={[
                "font-semibold text-sm",
                if(@assignment.metadata.change_action == :increase,
                  do: "text-success",
                  else: "text-error"
                )
              ]}>
                Point Recovery
              </h4>
              <p class="text-xs opacity-70">
                <%= if @assignment.metadata.change_action == :increase do %>
                  {@assignment.metadata.change_amount} point(s) added to your standing
                <% else %>
                  Lost {@assignment.metadata.change_amount} points
                <% end %>
              </p>
            </div>
            <div class="flex justify-center">
              <%= if @assignment.metadata.change_action == :increase do %>
                <div class="w-7 h-7 bg-success text-white rounded-full flex items-center justify-center">
                  <span class="text-success-content text-lg text-bold">
                    {@assignment.metadata.change_amount}
                  </span>
                </div>
              <% else %>
                <div class="w-7 h-7 bg-error text-white rounded-full flex items-center justify-center">
                  <span class="text-error-content text-lg text-bold">
                    {@assignment.metadata.change_amount}
                  </span>
                </div>
              <% end %>
            </div>
          </div>
        </div>
      <% end %>

      <%!-- Recurrence Status --%>
      <div class="card shadow-sm bg-base-100 flex-1">
        <div class="card-body p-4 text-center flex flex-col justify-between items-center gap-2">
          <div class="flex flex-col">
            <h4 class={[
              "font-semibold text-sm",
              if(@assignment.metadata.recurrent, do: "text-error", else: "text-success")
            ]}>
              <%= if @assignment.metadata.recurrent do %>
                Recurrent Issue
              <% else %>
                Non-Recurrent
              <% end %>
            </h4>
            <p class="text-xs opacity-70">
              <%= if @assignment.metadata.recurrent do %>
                3+ times in 10 days interval
              <% else %>
                First in 10 days interval
              <% end %>
            </p>
          </div>
          <div class="flex justify-center">
            <.icon
              name="hero-arrow-path"
              class={
                if(@assignment.metadata.recurrent,
                  do: "h-7 w-7 text-error",
                  else: "h-7 w-7 text-success"
                )
              }
            />
          </div>
        </div>
      </div>

      <%!-- Time Remaining --%>
      <%= if @assignment.status == :open do %>
        <div class="card shadow-sm bg-base-100 flex-1">
          <div class="card-body p-4 text-center flex flex-col justify-between items-center gap-2">
            <div class="flex flex-col">
              <h4 class="font-semibold text-sm text-warning">Time Remaining</h4>
              <p class="text-xs opacity-70">
                Acknowledgment window
              </p>
            </div>
            <div
              id="countdown"
              class="text-lg font-bold text-warning"
              phx-hook="Countdown"
              data-seconds={@meta.time_left}
            >
              <span class="loading loading-spinner loading-md"></span>
            </div>
          </div>
        </div>
      <% end %>
    </div>

    <%!-- Alert Details --%>
    <div class="card bg-base-100 shadow-sm">
      <div class="card-body">
        <%!-- Alert Header --%>
        <h3 class="card-title mb-4">
          Alert Details
          <.link navigate={~p"/"}>
            <.icon name="hero-arrow-top-right-on-square mb-1" class="w-4 h-4" />
          </.link>
        </h3>

        <div class="flex flex-col lg:flex-row gap-6">
          <div class="flex-1 space-y-4">
            <%!-- Alert ID --%>
            <div class="space-y-2">
              <label class="label">
                <span class="label-text font-medium">Alert ID</span>
              </label>
              <p class="text-sm">{@assignment.alert.logz_id}</p>
            </div>
            <%!-- Alert Title --%>
            <div class="space-y-2">
              <label class="label">
                <span class="label-text font-medium">Alert Title</span>
              </label>
              <p class="text-base-content">{@assignment.alert.alert_title}</p>
            </div>

            <%!-- Alert Severity --%>
            <div class="flex flex-col gap-2">
              <label class="label">
                <span class="label-text font-medium">Severity</span>
              </label>
              <div class={[
                "badge",
                case @assignment.alert.alert_severity do
                  "high" -> "badge-error"
                  "medium" -> "badge-warning"
                  "low" -> "badge-success"
                  _ -> "badge-neutral"
                end
              ]}>
                {String.capitalize(@assignment.alert.alert_severity)}
              </div>
            </div>
          </div>

          <div class="flex-1 space-y-4">
            <div class="space-y-2">
              <label class="label">
                <span class="label-text font-medium">Time Range</span>
              </label>
              <p class="text-sm">
                {Calendar.strftime(@assignment.alert.start, "%Y-%m-%d %H:%M UTC")} to {Calendar.strftime(
                  @assignment.alert.end,
                  "%Y-%m-%d %H:%M UTC"
                )}
              </p>
            </div>

            <div class="space-y-2">
              <label class="label">
                <span class="label-text font-medium">Tags</span>
              </label>
              <div class="flex flex-wrap gap-2">
                <%= for tag <- @assignment.alert.alert_tags do %>
                  <div class="badge badge-neutral badge-sm">
                    {tag}
                  </div>
                <% end %>
              </div>
            </div>
          </div>
        </div>

        <div class="mt-4 space-y-2">
          <label class="label">
            <span class="label-text font-medium">Description</span>
          </label>
          <p>
            {@assignment.alert.alert_description}
          </p>
        </div>

        <%= if @assignment.alert.alert_event_samples do %>
          <div class="mt-4 space-y-2">
            <label class="label">
              <span class="label-text font-medium">Event Samples</span>
            </label>
            <div class="card bg-base-200 text-sm p-4">
              <pre class="whitespace-pre-wrap"><code>{@assignment.alert.alert_event_samples}</code></pre>
            </div>
          </div>
        <% end %>
      </div>
    </div>

    <%!-- Acknowledgment Form --%>
    <%= if @assignment_closed do %>
      <div class="card bg-base-100 shadow-sm">
        <div class="card-body">
          <h3 class="card-title text-success">Assignment Already Acknowledged</h3>
          <p class="text-base-content/80">
            This assignment has been closed and can no longer be acknowledged.
          </p>
          <div class="card-actions justify-end">
            <.link navigate={~p"/"} class="btn btn-primary">
              Back to Assignments
            </.link>
          </div>
        </div>
      </div>
    <% else %>
      <form phx-submit="acknowledge" phx-change="validate" class="card bg-base-100 shadow-sm">
        <div class="card-body flex flex-col gap-4">
          <h3 class="card-title">Acknowledgment Form</h3>

          <p class="text-sm text-base-content/70">
            To acknownledge this alert that was assigned to you, please
            type out the phrase bellow. By acknowledging, you confirm that
            you have reviewed and understood this alert assignment.
          </p>

          <div class="card bg-base-200 flex flex-row gap-2 items-center p-2">
            <.icon name="hero-chevron-right" class="text-primary w-6 h-6" />
            <p class="text-sm">
              {@required_phrase}
            </p>
          </div>

          <input
            id="acknowledgment_phrase"
            name="acknowledgment_phrase"
            value={@acknowledgment_phrase}
            phx-hook="NoPaste"
            class={[
              "input input-bordered w-full  resize-none",
              if(@acknowledgment_phrase != "" and @acknowledgment_phrase != @required_phrase,
                do: "input-error",
                else:
                  if(@acknowledgment_phrase == @required_phrase,
                    do: "input-success",
                    else: ""
                  )
              )
            ]}
            placeholder="Type the exact phrase here..."
            required
            autocomplete="off"
            spellcheck="false"
          />
          <%= if @acknowledgment_phrase != "" and @acknowledgment_phrase != @required_phrase do %>
            <div class="label">
              <span class="label-text-alt text-error">
                Phrase doesn't match. Please type exactly as shown above.
              </span>
            </div>
          <% end %>
          <%= if @acknowledgment_phrase == @required_phrase do %>
            <div class="label">
              <span class="label-text-alt text-success">✓ Phrase matches!</span>
            </div>
          <% end %>

          <div class="card-actions justify-end items-center">
            <button
              type="submit"
              disabled={@submitting || @acknowledgment_phrase != @required_phrase}
              class={[
                "btn mt-2",
                if(@submitting || @acknowledgment_phrase != @required_phrase,
                  do: "btn-disabled",
                  else: "btn-primary"
                )
              ]}
            >
              <%= if @submitting do %>
                <span class="loading loading-spinner loading-sm"></span> Submitting...
              <% else %>
                Acknowledge Assignment
              <% end %>
            </button>
          </div>
        </div>
      </form>
    <% end %>
  </div>
</Layouts.app>
