<Layouts.app flash={@flash} current_scope={@current_scope}>
  <div class="max-w-5xl mx-auto my-10 space-y-4">
    <%!-- Header --%>
    <.header>
      <p class="text-3xl">Acknowledgement Form</p>
    </.header>

    <%!-- Alert Messages (conditional based on status) --%>
    <%= if @meta.alert_message do %>
      <% {alert_type, message} = @meta.alert_message %>
      <div role="alert" class={"alert alert-#{alert_type} alert-soft mt-2"}>
        <.icon
          name={
            if alert_type == :warning,
              do: "hero-exclamation-triangle",
              else: "hero-information-circle"
          }
          class="size-6"
        />
        <span class="text-sm">{message}</span>
      </div>
    <% end %>

    <%!-- Unassigned Banner --%>
    <%= if @assignment.status == :unassigned do %>
      <div role="alert" class="alert alert-warning alert-soft mt-2">
        <.icon name="hero-exclamation-triangle" class="size-6" />
        <div class="text-sm">
          <strong>Unassigned:</strong>
          This alert has been created but is not assigned to any specific user.
          Please review the event logs below to determine the appropriate assignee, then use the transfer form to assign it to the correct user.
        </div>
      </div>
    <% end %>

    <%!-- Assignment Status Section --%>
    <.live_component
      module={NotifeyeWeb.Components.Assignments.StatusSection}
      id="status-section"
      assignment={@assignment}
      current_scope={@current_scope}
      meta={@meta}
    />

    <%!-- Admin Actions Section --%>
    <.live_component
      module={NotifeyeWeb.Components.Assignments.AdminActions}
      id="admin-actions"
      assignment={@assignment}
      current_scope={@current_scope}
      meta={@meta}
      available_users={@available_users}
      transfer_user_id={@transfer_user_id}
    />

    <%!-- Alert Details --%>
    <.live_component
      module={NotifeyeWeb.Components.Assignments.AlertDetails}
      id="alert-details"
      assignment={@assignment}
    />

    <%!-- User Acknowledgment Form --%>
    <.live_component
      module={NotifeyeWeb.Components.Assignments.AcknowledgmentForm}
      id="acknowledgment-form"
      assignment={@assignment}
      meta={@meta}
      required_phrase={@required_phrase}
      acknowledgment_phrase={@acknowledgment_phrase}
    />

    <%!-- Closed Assignment Message --%>
    <%= if @assignment.status == :closed do %>
      <div class="card bg-base-100 shadow-sm">
        <div class="card-body">
          <h3 class="card-title text-success">Acknowledged</h3>
          <p class="text-base-content/80">
            This assignment has been closed and can no longer be acknowledged.
          </p>
          <div class="card-actions justify-end">
            <.link navigate={~p"/"} class="btn btn-primary">
              Back to Assignments
            </.link>
          </div>
        </div>
      </div>
    <% end %>

    <%!-- Expired Assignment Message (for non-admin users) --%>
    <%= if @assignment.status == :expired and @current_scope.user.role != :admin do %>
      <div class="card bg-base-100 shadow-sm">
        <div class="card-body">
          <h3 class="card-title text-error">Assignment Expired</h3>
          <p class="text-base-content/80">
            This assignment has expired and can no longer be acknowledged.
            Please contact an administrator if you need assistance.
          </p>
          <div class="card-actions justify-end">
            <.link navigate={~p"/"} class="btn btn-primary">
              Back to Assignments
            </.link>
          </div>
        </div>
      </div>
    <% end %>
  </div>
</Layouts.app>
