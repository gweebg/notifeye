<Layouts.app flash={@flash} current_scope={@current_scope} current_path={@current_path}>
  <div class="m-6 space-y-6 p-4">
    <.header>
      <p class="text-3xl">Dashboard</p>
      <:subtitle>
        <div class="breadcrumbs text-sm">
          <ul>
            <li>
              <.link href={~p"/"}>
                <.icon name="hero-home" /> Home
              </.link>
            </li>
          </ul>
        </div>
      </:subtitle>
      <:actions>
        <!-- Controls Row -->
        <div class="flex flex-wrap gap-4">
          <!-- Time Window Selector -->
          <form phx-change="change_time_window">
            <label class="label">
              <span class="label-text text-xs">Time Window</span>
            </label>
            <select class="select select-bordered select-sm" name="time_window">
              <option value="day" selected={@time_window == :day}>Last 24 Hours</option>
              <option value="week" selected={@time_window == :week}>Last 7 Days</option>
              <option value="month" selected={@time_window == :month}>Last 30 Days</option>
            </select>
          </form>
          
<!-- Refresh Interval -->
          <div class="form-control">
            <label class="label">
              <span class="label-text">Auto Refresh</span>
            </label>
            <select
              class="select select-bordered select-sm"
              phx-change="change_refresh_interval"
              name="interval"
            >
              <option value="1" selected={@refresh_interval == 1}>1 second</option>
              <option value="5" selected={@refresh_interval == 5}>5 seconds</option>
              <option value="10" selected={@refresh_interval == 10}>10 seconds</option>
              <option value="30" selected={@refresh_interval == 30}>30 seconds</option>
            </select>
          </div>
          
<!-- Manual Refresh -->
          <div class="form-control">
            <label class="label">
              <span class="label-text">&nbsp;</span>
            </label>
            <button class="btn btn-outline btn-sm" phx-click="refresh_data">
              <.icon name="hero-arrow-path" class="w-4 h-4" /> Refresh
            </button>
          </div>
          
<!-- Loading Indicator -->
          <div class="form-control">
            <label class="label">
              <span class="label-text">&nbsp;</span>
            </label>
            <div class={[
              "loading loading-spinner loading-sm",
              if(@loading, do: "opacity-100", else: "opacity-0")
            ]}>
            </div>
          </div>
        </div>
      </:actions>
    </.header>
    
<!-- Dashboard Grid - 2 columns with left column split horizontally -->
    <div class="grid grid-cols-1 xl:grid-cols-2 gap-6">
      <!-- Left Column - Split into two sections -->
      <div class="space-y-6">
        <%!-- Alerts Card --%>
        <.live_component
          module={NotifeyeWeb.Components.Dashboard.AlertsStats}
          id="alerts-stats"
          time_window={format_time_window(@time_window)}
          stats={@alert_stats}
        />
        
<!-- Assignments Card -->
        <div class="card bg-base-100 border border-base-200 shadow-sm">
          <div class="card-body">
            <h2 class="card-title mb-4">
              <.icon name="hero-user-group" class="w-5 h-5 text-info" /> Assignments
              <span class="text-sm text-base-content/60 font-normal">
                ({format_time_window(@time_window)})
              </span>
            </h2>
            
<!-- Assignment Statistics -->
            <div class="grid grid-cols-4 gap-2 mb-6">
              <div class="stat bg-success/10 rounded-lg p-3">
                <div class="stat-title text-xs">Open</div>
                <div class="stat-value text-lg text-success">
                  {get_stat(@assignment_stats, :open, 0)}
                </div>
              </div>
              <div class="stat bg-warning/10 rounded-lg p-3">
                <div class="stat-title text-xs">Unassigned</div>
                <div class="stat-value text-lg text-warning">
                  {get_stat(@assignment_stats, :unassigned, 0)}
                </div>
              </div>
              <div class="stat bg-info/10 rounded-lg p-3">
                <div class="stat-title text-xs">Closed</div>
                <div class="stat-value text-lg text-info">
                  {get_stat(@assignment_stats, :closed, 0)}
                </div>
              </div>
              <div class="stat bg-error/10 rounded-lg p-3">
                <div class="stat-title text-xs">Expired</div>
                <div class="stat-value text-lg text-error">
                  {get_stat(@assignment_stats, :expired, 0)}
                </div>
              </div>
            </div>
            
<!-- Recent Assignments Table -->
            <div class="overflow-x-auto">
              <table class="table table-xs">
                <thead>
                  <tr>
                    <th>User</th>
                    <th>Status</th>
                    <th>Alert</th>
                    <th>Time</th>
                  </tr>
                </thead>
                <tbody>
                  <tr>
                    <td colspan="4" class="text-center text-base-content/50 py-8">
                      Recent assignments will appear here...
                    </td>
                  </tr>
                </tbody>
              </table>
            </div>
          </div>
        </div>
      </div>
      
<!-- Right Column - Notifications -->
      <div>
        <.live_component
          module={NotifeyeWeb.Components.Dashboard.NotificationStats}
          id="notification-stats"
          time_window={format_time_window(@time_window)}
          count_by_state={Map.get(@notification_stats, :delivery_breakdown, nil)}
          notifications={Map.get(@notification_stats, :recent_notifications, [])}
        />
      </div>
    </div>
  </div>
</Layouts.app>
