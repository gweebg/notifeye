<Layouts.app flash={@flash} current_scope={@current_scope}>
  <div class="max-w-7xl mx-auto space-y-4">
    <.header>
      <p class="text-2xl">Alert Description #{@alert_description.id}</p>
      <:subtitle>
        Update the alert description settings and test your regex pattern.
      </:subtitle>
      <:actions>
        <.link
          navigate={~p"/admin/descriptions/#{@alert_description.id}/edit"}
          class="btn btn-primary"
        >
          <.icon name="hero-pencil" class="w-4 h-4" /> Edit Description
        </.link>
      </:actions>
    </.header>
    
<!-- Main Content -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
      
<!-- Left Column - Main Details -->
      <div class="lg:col-span-2 space-y-6">
        
<!-- Overview Card -->
        <div class="card bg-base-100 shadow-lg border border-base-200">
          <div class="card-body">
            <div class="flex items-center justify-between mb-6">
              <h2 class="card-title text-xl">
                <.icon name="hero-document-text" class="w-6 h-6" /> Overview
              </h2>
              <div class="badge badge-outline font-mono text-sm">
                ID: {@alert_description.id}
              </div>
            </div>

            <%!-- Pattern Section --%>
            <div class="mb-6">
              <label class="label pb-1">
                <span class="label-text font-semibold">Pattern</span>
              </label>
              <div class="bg-base-200 overflow-y-auto">
                <pre class="px-4 py-3"><code class="text-sm text-black">{if @alert_description.pattern do
                      @alert_description.pattern
                    else
                      "No pattern defined"
                    end}</code></pre>
              </div>
            </div>
             <%!-- Metadata Grid --%>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
              <div class="space-y-4">
                <div>
                  <label class="label pb-1">
                    <span class="label-text font-semibold">Notification Group</span>
                  </label>
                  <div class="flex items-center space-x-2">
                    <.icon name="hero-user-group" class="w-4 h-4 text-gray-500" />
                    <span class="text-sm">
                      {if @alert_description.notification_group_id do
                        "Group #{@alert_description.notification_group.name}"
                      else
                        "No group assigned"
                      end}
                    </span>
                  </div>
                </div>

                <div>
                  <label class="label pb-1">
                    <span class="label-text font-semibold">Edited By</span>
                  </label>
                  <div class="flex items-center space-x-2">
                    <.icon name="hero-user" class="w-4 h-4 text-gray-500" />
                    <span class="text-sm">
                      {if @alert_description.edited_by do
                        "#{@alert_description.user.email}"
                      else
                        "-"
                      end}
                    </span>
                  </div>
                </div>
              </div>

              <div class="space-y-4">
                <div>
                  <label class="label pb-1">
                    <span class="label-text font-semibold">Created</span>
                  </label>
                  <div class="flex items-center space-x-2">
                    <.icon name="hero-calendar" class="w-4 h-4 text-gray-500" />
                    <span class="text-sm">
                      {Calendar.strftime(
                        @alert_description.inserted_at,
                        "%B %d, %Y at %H:%M UTC"
                      )}
                    </span>
                  </div>
                </div>

                <div>
                  <label class="label pb-1">
                    <span class="label-text font-semibold">Last Updated</span>
                  </label>
                  <div class="flex items-center space-x-2">
                    <.icon name="hero-clock" class="w-4 h-4 text-gray-500" />
                    <span class="text-sm">
                      {Calendar.strftime(
                        @alert_description.updated_at,
                        "%B %d, %Y at %H:%M UTC"
                      )}
                    </span>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
        
<!-- Related Alerts Section -->
        <div class="card bg-base-100 shadow-lg border border-base-200">
          <div class="card-body">
            <div class="flex items-center justify-between mb-6">
              <h2 class="card-title text-xl">
                <.icon name="hero-exclamation-triangle" class="w-6 h-6 text-warning" />
                Related Alerts
              </h2>
              <div class="badge badge-neutral badge-lg">
                {length(@alerts)} alerts
              </div>
            </div>

            <div :if={Enum.empty?(@alerts)} class="text-center py-12">
              <.icon name="hero-inbox" class="w-16 h-16 text-gray-300 mx-auto mb-4" />
              <p class="text-gray-500 text-lg">No alerts found</p>
              <p class="text-gray-400 text-sm">
                There are no alerts related to this description.
              </p>
            </div>

            <div :if={not Enum.empty?(@alerts)} class="overflow-x-auto">
              <table class="table table-zebra w-full">
                <thead>
                  <tr class="bg-base-200">
                    <th class="font-semibold">Logz ID</th>
                    <th class="font-semibold">Alert Title</th>
                    <th class="font-semibold">Severity</th>
                    <th class="font-semibold">Duration</th>
                    <th class="font-semibold text-center">Actions</th>
                  </tr>
                </thead>
                <tbody>
                  <tr :for={alert <- @alerts} class="hover">
                    <td class="font-mono text-sm">{alert.logz_id}</td>
                    <td class="max-w-xs">
                      <div class="truncate font-medium">{alert.alert_title}</div>
                    </td>
                    <td>
                      <div class={[
                        "badge",
                        case alert.alert_severity do
                          "HIGH" -> "badge-error"
                          "MEDIUM" -> "badge-warning"
                          "LOW" -> "badge-info"
                          _ -> "badge-outline"
                        end
                      ]}>
                        {alert.alert_severity}
                      </div>
                    </td>
                    <td class="text-sm">
                      <div class="space-y-1">
                        <div>
                          <span class="text-gray-500">Start:</span>
                          {if alert.start,
                            do: Calendar.strftime(alert.start, "%m/%d %H:%M"),
                            else: "N/A"}
                        </div>
                        <div>
                          <span class="text-gray-500">End:</span>
                          {if alert.end,
                            do: Calendar.strftime(alert.end, "%m/%d %H:%M"),
                            else: "Ongoing"}
                        </div>
                      </div>
                    </td>
                    <td class="text-center">
                      <.link navigate={~p"/alerts/#{alert.id}"} class="btn btn-ghost btn-sm">
                        <.icon name="hero-eye" class="w-4 h-4" />
                      </.link>
                    </td>
                  </tr>
                </tbody>
              </table>
            </div>
          </div>
        </div>
      </div>
      
<!-- Right Column - Sidebar -->
      <div class="space-y-6">
        
<!-- Quick Stats -->
        <div class="card bg-base-100 shadow-lg border border-base-200">
          <div class="card-body">
            <h3 class="card-title text-lg mb-4">
              <.icon name="hero-chart-bar" class="w-5 h-5 text-primary" /> Quick Stats
            </h3>

            <div class="space-y-4">
              <div class="stat bg-base-50 rounded-lg p-4">
                <div class="stat-title text-xs">Total Alerts</div>
                <div class="stat-value text-2xl text-primary">{length(@alerts)}</div>
              </div>

              <div class="stat bg-base-50 rounded-lg p-4">
                <div class="stat-title text-xs">Assignments</div>
                <div class="stat-value text-2xl text-secondary">
                  {length(@alert_assignments)}
                </div>
              </div>

              <div class="stat bg-base-50 rounded-lg p-4">
                <div class="stat-title text-xs">Status</div>
                <div class="stat-value text-lg flex items-center gap-2">
                  <div class={[
                    "badge badge-sm",
                    case @alert_description.state do
                      :enabled -> "badge-success"
                      :disabled -> "badge-error"
                      :grouponly -> "badge-warning"
                    end
                  ]}>
                    {String.capitalize(to_string(@alert_description.state))}
                  </div>
                  <div class={[
                    "badge badge-sm",
                    if @alert_description.verified do
                      "badge-success"
                    else
                      "badge-outline"
                    end
                  ]}>
                    {if @alert_description.verified, do: "Verified", else: "Unverified"}
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
        
<!-- Alert Assignments -->
        <div class="card bg-base-100 shadow-lg border border-base-200">
          <div class="card-body">
            <div class="flex items-center justify-between mb-4">
              <h3 class="card-title text-lg">
                <.icon name="hero-users" class="w-5 h-5 text-secondary" /> Assignments
              </h3>
              <div class="badge badge-secondary badge-outline">
                {length(@alert_assignments)}
              </div>
            </div>

            <div :if={Enum.empty?(@alert_assignments)} class="text-center py-8">
              <.icon name="hero-user-plus" class="w-12 h-12 text-gray-300 mx-auto mb-3" />
              <p class="text-gray-500">No assignments</p>
              <p class="text-gray-400 text-sm">No users assigned to this alert</p>
            </div>

            <div :if={not Enum.empty?(@alert_assignments)} class="space-y-3">
              <div
                :for={assignment <- @alert_assignments}
                class="border border-base-200 rounded-lg p-3 hover:bg-base-50 transition-colors"
              >
                <div class="flex items-center justify-between">
                  <div>
                    <div class="font-medium text-sm">User {assignment.user_id}</div>
                  </div>
                  <div class="text-xs text-gray-500">
                    {Calendar.strftime(assignment.inserted_at, "%m/%d")}
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
        
<!-- Actions -->
        <div class="card bg-base-100 shadow-lg border border-base-200">
          <div class="card-body">
            <h3 class="card-title text-lg mb-4">
              <.icon name="hero-cog-6-tooth" class="w-5 h-5 text-accent" /> Actions
            </h3>

            <div class="space-y-3">
              <.link
                navigate={~p"/admin/descriptions/#{@alert_description.id}/edit"}
                class="btn btn-primary btn-block"
              >
                <.icon name="hero-pencil" class="w-4 h-4" /> Edit Description
              </.link>

              <button
                class="btn btn-error btn-outline btn-block"
                phx-click="delete_description"
                phx-value-id={@alert_description.id}
                data-confirm="Are you sure you want to delete this alert description? This action cannot be undone."
              >
                <.icon name="hero-trash" class="w-4 h-4" /> Delete
              </button>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</Layouts.app>
